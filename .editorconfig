# 编辑器统一配置（CLAUDE.md 第 13 节）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,py}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,js,ts,vue,html,css,scss,xml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
