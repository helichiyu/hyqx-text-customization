{
  "operator_name": "PTt_extract_pdf_body",
  "detection": "PTt_extract_pdf_body",
  "display_name": "提取PDF正文",
  "tool_type": "小模型",
  "stage": "清洗·正文",
  "version": "1.1.0",
  "skippable": "是（可选-必填1个）",
  "api_path": "/predict",
  "description": "接收 PDF 文档并提取正文，输出纯文本内容；扫描版 PDF 需 OCR（OCR 依赖未装时明确报错，不静默输出空文档）；无文本层时 OCR 兜底：Qwen3-VL-8B-Instruct（硅基流动 API，与内部自部署同款）；param_OCR识别=关闭 可禁用",
  "input_schema": {
    "method": "POST",
    "path": "/predict?detection=PTt_extract_pdf_body",
    "content_type": "multipart/form-data",
    "form_fields": {
      "file": {
        "type": "file",
        "required": true,
        "description": "待处理文件（jsonl 每行一条记录；其他格式整体一条）"
      }
    },
    "params": {
      "param_页码范围": {
        "default": "全部"
      },
      "param_表格提取": {
        "default": "启用"
      },
      "param_图片文字提取": {
        "default": "启用"
      },
      "param_OCR识别": {
        "default": "启用"
      }
    },
    "limits": {
      "max_input_mb": 10,
      "max_response_mb": 50
    }
  },
  "output_schema": {
    "content_type": "application/json",
    "fields": {
      "code": {
        "type": "int",
        "description": "0=成功 1=失败"
      },
      "msg": {
        "type": "string",
        "description": "提示信息"
      },
      "data": {
        "type": "list",
        "items": {
          "fieldName": {
            "type": "string",
            "description": "记录标识"
          },
          "tags": {
            "type": "list",
            "description": "业务标签（主表拦截处理列标签原文）"
          },
          "action": {
            "type": "string",
            "description": "keep / remove / review"
          },
          "text": {
            "type": "string",
            "description": "提取的正文"
          },
          "pages": {
            "type": "string",
            "description": "提取的页数"
          },
          "status": {
            "type": "int",
            "description": "兼容主表 U 列：1=放行/处理成功，0=过滤/需复核（由 action 派生）"
          }
        }
      }
    }
  },
  "error_codes": [
    "FILE_EMPTY",
    "FILE_CORRUPT",
    "DECODE_FAIL",
    "PARSE_FAIL",
    "SIZE_EXCEEDED",
    "PARAM_INVALID",
    "MODEL_LOAD_FAIL",
    "INTERNAL_ERROR"
  ]
}
