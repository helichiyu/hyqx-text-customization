# oppretrain-cot-pool final environment template.
# Copy to .env on the deployment server and replace all placeholders.
# Never commit the real .env file.

APP_NAME=oppretrain-cot-pool
APP_VERSION=1.0.0
APP_PORT=17056

# Inbound platform -> operator service authentication.
AUTH_TOKEN_SHA256=replace-with-sha256-digest

# Outbound operator -> IDG model gateway authentication.
COT_MODEL_PROVIDER=idg
COT_MODEL_BASE_URL=http://10.252.92.98:9050
COT_MODEL_APP_ID=replace-with-appid
COT_MODEL_APP_KEY=replace-with-appkey
COT_MODEL_TIMEOUT_SECONDS=600
COT_MODEL_RETRIES=2

# CoT models already used by this line.
COT_T04_MODEL=Qwen3.8-27B
COT_T04_MODEL_PATH=/data-produce-1
COT_T12_MODEL=Qwen3.8-27B
COT_T12_MODEL_PATH=/data-produce-1

COT_T06_MODEL=Qwen3.5-4B
COT_T06_MODEL_PATH=/data-qwen3.5-4b
COT_T07_MODEL=Qwen3.5-4B
COT_T07_MODEL_PATH=/data-qwen3.5-4b
COT_T08_MODEL=Qwen3.5-4B
COT_T08_MODEL_PATH=/data-qwen3.5-4b

COT_T09_MODEL=Qwen3.5-4B
COT_T09_MODEL_PATH=/data-qwen3.5-4b
COT_T10_MODEL=Qwen3.5-4B
COT_T10_MODEL_PATH=/data-qwen3.5-4b

COT_T13_MODEL=Qwen3.5-2B
COT_T13_MODEL_PATH=/data-qwen35-2b-api

COT_T14_MODEL=Qwen3.8-27B
COT_T14_MODEL_PATH=/data-produce-1

COT_T15_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
COT_T15_EMBEDDING_PATH=/Qwen3-Embedding-0.6B/embeddings

# Runtime
COT_RUNTIME_ROOT=/app/runtime
MAX_INPUT_BYTES=536870912
MAX_OUTPUT_ROWS=100000