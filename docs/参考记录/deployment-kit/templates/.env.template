# Copy to the product directory as .env and replace all placeholders.
APP_NAME=replace-with-product-name
APP_VERSION=1.0.0
APP_PORT=17055

# Inbound API authentication: SHA-256 digest of the X-Token value.
AUTH_TOKEN_SHA256=replace-with-sha256-digest

# Outbound model gateway authentication.
MODEL_PROVIDER=idg
MODEL_GATEWAY_BASE_URL=http://replace-with-model-gateway:9050
MODEL_APP_ID=replace-with-appid
MODEL_APP_KEY=replace-with-appkey
MODEL_NAME=replace-with-model-name
MODEL_PATH=/replace-with-model-path

# Generic service endpoints
HEALTH_PATH=/health
OPERATORS_PATH=/operators
REQUIRE_AUTH=1
AUTH_WHITELIST_PATHS=/health,/healthz
