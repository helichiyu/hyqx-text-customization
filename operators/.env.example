# 文本定制化生产 · 本地联调环境变量模板（复制为 operators/.env 后填实际值；.env 不入库）
# 用法（Git Bash，在算子目录直跑 inference.py 前）：
#   set -a && source operators/.env && set +a
# per-port compose 会自动读取 compose 文件同目录的 .env。

# ---- IDG/磐智模型网关（默认后端，MODEL_PROVIDER=idg）----
# 联调 APPID/APPKEY 见 docs/参考记录/聊天记录.txt 第一节
MODEL_APP_ID=audioasr
MODEL_APP_KEY=<磐智联调 APPKEY>
# MODEL_GATEWAY_BASE_URL=http://10.252.92.98:9050   # 默认值，换址才配

# ---- SiliconFlow 回退后端（MODEL_PROVIDER=siliconflow 时必填）----
# SILICONFLOW_API_KEY=sk-...

# ---- 入站认证（平台 → 算子）----
# 本产线令牌（2026-11-18 生成，勿复用其他产线令牌）：
# 明文只放调用方与本地 .env；服务端/平台侧只配下面的摘要。
AUTH_TOKEN=<本产线令牌明文>
AUTH_TOKEN_SHA256=<本产线令牌摘要>
