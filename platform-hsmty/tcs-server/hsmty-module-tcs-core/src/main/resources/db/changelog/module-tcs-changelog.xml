<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        文本定制化生产模块变更汇聚入口。

        业务迁移时按以下规则新增文件并在本文件 include：
          001_tcs_{对象}_init.xml        建表
          002_tcs_dict_init.xml          字典来源/类型/项
          003_tcs_menu_init.xml          菜单与权限按钮
          004_tcs_{对象}_add_column.xml  结构变更

        changeSet id 统一为 {业务}-{动作}-{对象}-{yyyyMMdd}，已执行的 changeSet 禁止修改。
        当前仅完成架构骨架，尚未迁移业务表，因此 001_tcs_init.xml 暂无 changeSet。
    -->

    <include file="db/changelog/tcs/001_tcs_init.xml" relativeToChangelogFile="false"/>
</databaseChangeLog>
