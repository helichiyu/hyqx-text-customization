<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 素材批次：上传 → 校验 → 移交。 -->
    <changeSet id="tcs-create-mat-batch-20261111" author="helichiyu" context="mysql,postgresql">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="tcs_mat_batch"/></not>
        </preConditions>
        <createTable tableName="tcs_mat_batch" remarks="素材批次">
            <column name="id" type="BIGINT" remarks="内部主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="biz_no" type="VARCHAR(32)" remarks="批次业务编号">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(128)" remarks="批次名称">
                <constraints nullable="false"/>
            </column>
            <column name="line" type="VARCHAR(32)" remarks="产线代码">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)" remarks="状态：draft/passed/rejected/released">
                <constraints nullable="false"/>
            </column>
            <column name="file_count" type="INT" remarks="文件数"/>
            <column name="total_count" type="INT" remarks="条目总数"/>
            <column name="reject_summary" type="CLOB" remarks="拒绝原因汇总 JSON"/>
            <column name="create_by" type="VARCHAR(64)" remarks="创建人展示名"/>
            <column name="create_id" type="VARCHAR(64)" remarks="创建人 ID"/>
            <column name="create_time" type="TIMESTAMP" remarks="创建时间"/>
            <column name="update_id" type="VARCHAR(64)" remarks="更新人 ID"/>
            <column name="update_time" type="TIMESTAMP" remarks="更新时间"/>
            <column name="del_flag" type="CHAR(1)" defaultValue="F" remarks="逻辑删除标记">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="tcs_mat_batch" columnNames="biz_no" constraintName="uk_tcs_mat_batch_biz_no"/>
        <createIndex tableName="tcs_mat_batch" indexName="idx_tcs_mat_batch_line_status">
            <column name="line"/>
            <column name="status"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
