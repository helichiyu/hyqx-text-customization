<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 数据集明细：一行一条算子输出，复核结论回写 review_status/revision_status。 -->
    <changeSet id="tcs-create-dataset-item-20261111" author="helichiyu" context="mysql,postgresql">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="tcs_dataset_item"/></not>
        </preConditions>
        <createTable tableName="tcs_dataset_item" remarks="数据集明细">
            <column name="id" type="BIGINT" remarks="内部主键">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="dataset_id" type="BIGINT" remarks="数据集内部主键">
                <constraints nullable="false"/>
            </column>
            <column name="task_id" type="BIGINT" remarks="来源任务内部主键"/>
            <column name="item_key" type="VARCHAR(128)" remarks="数据集行标识"/>
            <column name="payload" type="CLOB" remarks="算子原始行 JSON"/>
            <column name="review_status" type="VARCHAR(32)" remarks="复核状态：待复核/已确认A/已修正B/已剔除C"/>
            <column name="revision_status" type="VARCHAR(32)" remarks="修正状态：未修正/已修正/已剔除"/>
            <column name="confidence" type="DECIMAL(5,4)" remarks="置信度"/>
            <column name="create_id" type="VARCHAR(64)" remarks="创建人 ID"/>
            <column name="create_time" type="TIMESTAMP" remarks="创建时间"/>
            <column name="update_id" type="VARCHAR(64)" remarks="更新人 ID"/>
            <column name="update_time" type="TIMESTAMP" remarks="更新时间"/>
            <column name="del_flag" type="CHAR(1)" defaultValue="F" remarks="逻辑删除标记">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="tcs_dataset_item" indexName="idx_tcs_dataset_item_dataset">
            <column name="dataset_id"/>
        </createIndex>
        <createIndex tableName="tcs_dataset_item" indexName="idx_tcs_dataset_item_key">
            <column name="dataset_id"/>
            <column name="item_key"/>
        </createIndex>
        <createIndex tableName="tcs_dataset_item" indexName="idx_tcs_dataset_item_task">
            <column name="task_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
