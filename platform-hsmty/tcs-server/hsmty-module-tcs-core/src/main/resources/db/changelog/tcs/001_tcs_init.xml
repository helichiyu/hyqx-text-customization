<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        文本定制化生产模块初始化建表脚本。

        本轮只交付架构骨架，业务模型（工单/任务/素材/产物等）尚未迁移，
        因此暂不写入任何 changeSet —— 避免在此处凭空定义表结构后被误当作已确认模型。

        迁移业务代码时，按 CLAUDE.md 第 9.2 节在此文件中补全第一个建表 changeSet：

          <changeSet id="tcs-create-{对象}-yyyyMMdd" author="{提交人}" context="mysql,postgresql">
              <preConditions onFail="MARK_RAN">
                  <not><tableExists tableName="tcs_{对象}"/></not>
              </preConditions>
              ...
          </changeSet>

        表名必须是 tcs_ 前缀，字段与 PO、Mapper XML 的 BaseResultMap 三处一致。
        已执行后的 changeSet 不得修改，后续结构变更另起 NNN 文件。
    -->

</databaseChangeLog>
